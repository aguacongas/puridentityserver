     async def create_test_plan(self, name, configuration, variant=None):
+        # Reuse a plan we already created when its configuration is unchanged:
+        # the suite gives every plan a fresh random id, so re-POSTing the same
+        # configuration on each CI run would pile up duplicate plans and, worse,
+        # re-claim the alias while the previous run's modules are still active
+        # (the alias is the stable test identity on the hosted OpenID Foundation
+        # instance: every module created from a plan inherits it, and the suite
+        # stops any new module that claims an alias already in use). Plans are
+        # therefore created once per distinct configuration and re-run afterwards.
+        existing = await self._plan_matching_configuration(name, configuration, variant)
+        if existing is not None:
+            plan_id, modules = existing
+            print("Reusing existing test plan {} ({}) - configuration unchanged".format(plan_id, name))
+            return {'name': name, 'id': plan_id, 'modules': modules}
+
