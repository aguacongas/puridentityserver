+    async def _plan_matching_configuration(self, name, configuration, variant):
+        """Return (plan_id, modules) of a plan owned by the current user whose
+        stored configuration matches the one we are about to submit, or None if
+        no such plan exists (it will then be created).
+
+        A plan is reused only when it is strictly identical: same plan name,
+        same configuration (alias, server, browser rules...) and same variant
+        selection. Any change to the configuration therefore recreates the
+        plan, which is the intended way to roll changes out to the live suite."""
+        try:
+            wanted = json.loads(configuration)
+        except ValueError:
+            return None
+        if not isinstance(wanted, dict):
+            return None
+        wanted_alias = wanted.get('alias')
+        if not isinstance(wanted_alias, str) or not wanted_alias:
+            return None
+        wanted_variant = variant if isinstance(variant, dict) else None
+
+        api_url = '{0}api/plan'.format(self.api_url_base)
+        response = await self.httpclient.get(api_url, params={'start': 0, 'length': 1000})
+        if response.status_code != 200:
+            return None
+        for plan in (response.json().get('data') or []):
+            if plan.get('planName') != name:
+                continue
+            if plan.get('config') != wanted:
+                continue
+            if wanted_variant:
+                stored_variant = plan.get('variant')
+                if not isinstance(stored_variant, dict) or any(
+                        stored_variant.get(k) != v for k, v in wanted_variant.items()):
+                    continue
+            return plan.get('_id'), plan.get('modules') or []
+        return None
+
     @staticmethod
     def _extract_error_message(response):
