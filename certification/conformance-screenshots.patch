+    async def fill_required_screenshots(self, module_id):
+        # Certains modules OpenID Core (ex. oidcc-response-type-missing) mettent le
+        # test en pause avec un evenement de relecture REVIEW porteur d'un
+        # placeholder 'upload' : un humain doit televerser une capture d'ecran dans
+        # la console du navigateur, sinon wait_for_state reste bloque jusqu'au
+        # timeout (CONFORMANCE_MODULE_TIMEOUT). On liste ces placeholders via
+        # GET /api/log/{id}/images puis on les remplit via
+        # POST /api/log/{id}/images/{placeholder} avec un PNG de secours valide
+        # afin que le test se termine tout seul (mode witness : la capture fournie
+        # n'est pas une preuve d'execution reelle du navigateur).
+        api_url = '{0}api/log/{1}/images'.format(self.api_url_base, module_id)
+        response = await self.httpclient.get(api_url)
+        if response.status_code != 200:
+            raise Exception("fill_required_screenshots list failed - HTTP {:d} {}".format(response.status_code, response.content))
+        placeholders = [entry.get('upload') for entry in response.json() if isinstance(entry, dict) and entry.get('upload')]
+        filled = 0
+        for placeholder in placeholders:
+            upload_url = '{0}api/log/{1}/images/{2}'.format(self.api_url_base, module_id, placeholder)
+            upload = await self.httpclient.post(
+                upload_url,
+                content=STUB_SCREENSHOT_DATA_URI,
+                headers={'Content-Type': 'text/plain; charset=UTF-8'},
+            )
+            if upload.status_code != 200:
+                print("fill_required_screenshots upload {} failed - HTTP {:d} {}".format(placeholder, upload.status_code, upload.content))
+                continue
+            filled += 1
+        return filled
+
