+# intervention humaine (mode witness). L'API ImageAPI n'accepte que des data URI
+# image/png ou image/jpeg (<= 500 Ko).
+STUB_SCREENSHOT_DATA_URI = "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg=="
