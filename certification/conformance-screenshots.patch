+# Donnees (data URI) d'une capture d'ecran de secours : PNG 1x1 valide, utilise
+# pour remplir automatiquement les placeholders 'upload' des modules de relecture
+# (ex. oidcc-response-type-missing) afin que le test puisse se terminer sans
+# intervention humaine (mode witness). L'API ImageAPI n'accepte que des data URI
+# image/png ou image/jpeg (<= 500 Ko).
+STUB_SCREENSHOT_DATA_URI = "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg=="
+
+# Repertoire des captures reelles deposees par certification/capture_screenshots.py
+# (PNG nommes <testName>.png) ; variable d'environnement SCREENSHOTS_DIR, vide par
+# defaut.
+SCREENSHOTS_DIR_ENV = 'SCREENSHOTS_DIR'
+
+# Meme bornee que l'ImageAPI de la suite (data URI <= 500 Ko).
+MAX_SCREENSHOT_BYTES = 500 * 1024
+
+
+def screenshot_data_uri(test_name):
+    """Data URI (image/png) de la capture reelle d'un module, ou None.
+
+    Lit ``SCREENSHOTS_DIR/<testName>.png`` (variable SCREENSHOTS_DIR) ; renvoie
+    None si le repertoire n'est pas configure, si le fichier est absent ou
+    s'il depasse la limite de l'ImageAPI : l'appelant retombe alors sur le PNG
+    de secours, le deroulement n'est jamais interrompu pour une capture.
+    """
+    directory = os.getenv(SCREENSHOTS_DIR_ENV)
+    if not directory:
+        return None
+    path = os.path.join(directory, str(test_name) + '.png')
+    try:
+        with open(path, 'rb') as screenshot:
+            payload = screenshot.read()
+    except (IOError, OSError):
+        return None
+    if not payload or len(payload) > MAX_SCREENSHOT_BYTES:
+        return None
+    return 'data:image/png;base64,' + base64.b64encode(payload).decode('ascii')
+
+
