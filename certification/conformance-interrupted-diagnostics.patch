+    async def describe_interruption(self, module_id):
+        # Un module qui passe a INTERRUPTED juste apres sa creation (statut non
+        # permanent attendu par wait_for_state) s'explique par un echec de
+        # configuration/demarrage : la suite livre alors la cause dans le
+        # journal du test et le resultat du module. Sans ce detail, la CI ne
+        # voit qu'un « has moved to INTERRUPTED » et on ne peut pas distinguer
+        # un conflit d'alias d'une vraie erreur de configuration du test.
+        parts = []
+        try:
+            info = await self.get_module_info(module_id)
+        except Exception as e:
+            info = {}
+            parts.append("info indisponible - {}".format(e))
+        if info:
+            if info.get('status'):
+                parts.append("statut {}".format(info.get('status')))
+            if info.get('result'):
+                parts.append("resultat {}".format(info.get('result')))
+            if info.get('summary'):
+                parts.append("resume : {}".format(info.get('summary')))
+        try:
+            log = await self.get_test_log(module_id)
+        except Exception as e:
+            log = None
+            parts.append("journal indisponible - {}".format(e))
+        if log:
+            for entry in log[-10:]:
+                if not isinstance(entry, dict):
+                    continue
+                msg = entry.get('msg')
+                if not msg:
+                    continue
+                src = entry.get('src')
+                line = "{}: {}".format(src, msg) if src else str(msg)
+                parts.append(line.replace('\n', ' ')[:400])
+        return " | ".join(parts) if parts else "aucun detail disponible"
+
