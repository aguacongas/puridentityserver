+    async def describe_interruption(self, module_id):
+        # Detail d'un module qui ne se termine pas : INTERRUPTED juste apres sa
+        # creation (echec de configuration/demarrage, statut non permanent attendu
+        # par wait_for_state) ou timeout de module. La suite livre la cause dans le
+        # journal du test et le resultat du module ; sans ce detail, la CI ne voit
+        # qu'un « has moved to INTERRUPTED » ou un « Timed out waiting », et on ne
+        # peut pas distinguer un conflit d'alias d'une vraie erreur du test.
+        parts = []
+        try:
+            info = await self.get_module_info(module_id)
+        except Exception as e:
+            info = {}
+            parts.append("info indisponible - {}".format(e))
+        if info:
+            if info.get('status'):
+                parts.append("statut {}".format(info.get('status')))
+            if info.get('result'):
+                parts.append("resultat {}".format(info.get('result')))
+            if info.get('summary'):
+                parts.append("resume : {}".format(info.get('summary')))
+        try:
+            log = await self.get_test_log(module_id)
+        except Exception as e:
+            log = None
+            parts.append("journal indisponible - {}".format(e))
+        if log:
+            for entry in log[-10:]:
+                if not isinstance(entry, dict):
+                    continue
+                src = entry.get('src')
+                pieces = [str(entry.get('msg'))] if entry.get('msg') else []
+                # Certains evenements portent la cause reelle dans une cle
+                # annexe (« detail » pour BROWSER, « error » pour une exception).
+                for key in ('detail', 'error', 'exception', 'cause'):
+                    value = entry.get(key)
+                    if value:
+                        pieces.append("{}={}".format(key, value))
+                if not pieces:
+                    continue
+                line = "{}: {}".format(src, " | ".join(pieces)) if src else " | ".join(pieces)
+                parts.append(line.replace('\n', ' ')[:600])
+        return " | ".join(parts) if parts else "aucun detail disponible"
+
