+    async def _ensure_plan_membership(self, plan_info, name, configuration, variant):
+        """Recreate a reused plan whose stored module list references tests the
+        suite no longer publishes, so the run starts from a fresh membership.
+
+        A hosted-suite upgrade can rename or drop test modules while the plan
+        record keeps the old ids: every module creation then fails with HTTP
+        500 'test module not found'. Recreating the plan here refreshes its
+        module list (renamed tests are picked up by the same run) and avoids
+        pointless retries. A freshly posted plan is trusted as-is (no
+        recursion)."""
+        try:
+            available = await self.get_all_test_modules()
+        except Exception as e:
+            print("Plan membership validation skipped - catalogue unreachable: {}".format(e))
+            return plan_info
+        known = set()
+        for entry in available if isinstance(available, list) else []:
+            if not isinstance(entry, dict):
+                continue
+            for key in ('testName', 'testModule'):
+                if entry.get(key):
+                    known.add(entry[key])
+            for module in entry.get('modules') or []:
+                if isinstance(module, dict) and module.get('testModule'):
+                    known.add(module['testModule'])
+        modules = [m for m in (plan_info.get('modules') or []) if isinstance(m, dict)]
+        stale = [m.get('testModule') for m in modules
+                 if m.get('testModule') and m['testModule'] not in known]
+        if known and stale:
+            print("Stale plan membership for {} - {} of {} module(s) unknown to the suite: {}".format(
+                plan_info.get('id'), len(stale), len(modules), ', '.join(stale[:5])))
+            print("Recreating plan '{}' to refresh its module list".format(name))
+            fresh = await self.create_test_plan(name, configuration, variant, reuse=False)
+            print("Plan recreated as {}".format(fresh.get('id')))
+            return fresh
