    "fapi2-security-profile-final-user-rejects-authentication": {
      "browser": [
        {
          "match": "{OPURL}/authorize*",
          "tasks": [
            {
              "task": "Login",
              "optional": true,
              "match": "{OPURL}/login*",
              "commands": [
                ["text", "name", "username", "alice@example.com"],
                ["text", "name", "password", "password"],
                ["click", "css", "button[type=submit]"]
              ]
            },
            {
              "task": "Consent (refus attendu)",
              "optional": true,
              "match": "{OPURL}/consent*",
              "commands": [
                ["click", "css", "button[name=action][value=deny]"]
              ]
            },
            {
              "task": "Attente de l'envoi en query",
              "optional": true,
              "match": "{SUITEURL}test/a/*/callback?*",
              "commands": [
                ["wait", "id", "submission_complete", 30]
              ]
            },
            {
              "task": "Attente de l'envoi en fragment",
              "optional": true,
              "match": "{SUITEURL}test/a/*/callback#*",
              "commands": [
                ["wait", "id", "submission_complete", 30]
              ]
            }
          ]
        }
      ]
    },
