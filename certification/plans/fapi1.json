        {
          "task": "Consent",
          "optional": true,
          "match": "{OPURL}/consent*",
          "commands": [
            ["click", "css", "button[name=action][value=authorize]"]
          ]
        },
        {
          "task": "Attente de l'envoi en query",
          "optional": true,
          "match": "{SUITEURL}test/a/*/callback?*",
          "commands": [
            ["wait", "id", "submission_complete", 30]
          ]
        },
        {
          "task": "Attente de l'envoi en fragment",
          "optional": true,
          "match": "{SUITEURL}test/a/*/callback#*",
          "commands": [
            ["wait", "id", "submission_complete", 30]
          ]
        }
      ]
