{
  "alias": "puridentityserver-ekyc",
  "description": "PurIdentityServer - OpenID Connect for Identity Assurance (eKYC, hors programme officiel)",
  "browser_verbose": true,
  "server": {
    "discoveryUrl": "{OPURL}/.well-known/openid-configuration"
  },
  "ekyc": {
    "userinfo": {
      "verified_claims": {
        "verification": {
          "trust_framework": "de_aml",
          "assurance_level": "substantial",
          "evidence": [
            {
              "type": "document",
              "check_details": [{ "check_method": "pvp" }],
              "document_details": { "type": "de_erp_replacement_idcard" }
            }
          ]
        },
        "claims": {
          "given_name": "Alice",
          "family_name": "Martin",
          "middle_name": "Marie"
        }
      }
    },
    "verified_claims_request_list": [
      {
        "id_token": {
          "verified_claims": {
            "verification": { "trust_framework": null },
            "claims": { "given_name": null }
          }
        },
        "userinfo": {
          "verified_claims": {
            "verification": { "trust_framework": null },
            "claims": { "given_name": null }
          }
        }
      }
    ]
  },
  "browser": [
    {
      "match": "{OPURL}/authorize*",
      "tasks": [
        {
          "task": "Login",
          "optional": true,
          "match": "{OPURL}/login*",
          "commands": [
            ["text", "name", "username", "alice@example.com"],
            ["text", "name", "password", "password"],
            ["click", "css", "button[type=submit]"]
          ]
        },
        {
          "task": "Consent",
          "optional": true,
          "match": "{OPURL}/consent*",
          "commands": [
            ["click", "css", "button[name=action][value=authorize]"]
          ]
        },
        {
          "task": "Attente de l'envoi (query)",
          "optional": true,
          "match": "{SUITEURL}test/a/*/callback?*",
          "commands": [
            ["wait", "id", "submission_complete", 30]
          ]
        }
      ]
    }
  ]
}
