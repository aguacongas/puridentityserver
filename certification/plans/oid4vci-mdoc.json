{
  "alias": "puridentityserver-oid4vci-mdoc",
  "description": "PurIdentityServer - OID4VCI OP mdoc (mso_mdoc) certification (CI)",
  "browser_verbose": true,
  "server": {
    "discoveryUrl": "{OPURL}/.well-known/openid-configuration"
  },
  "browser": [
    {
      "match": "{OPURL}/authorize*",
      "tasks": [
        {
          "task": "Login",
          "optional": true,
          "match": "{OPURL}/login*",
          "commands": [
            [
              "text",
              "name",
              "username",
              "alice@example.com"
            ],
            [
              "text",
              "name",
              "password",
              "password"
            ],
            [
              "click",
              "css",
              "button[type=submit]"
            ]
          ]
        },
        {
          "task": "Consent",
          "optional": true,
          "match": "{OPURL}/consent*",
          "commands": [
            [
              "click",
              "css",
              "button[name=action][value=authorize]"
            ]
          ]
        },
        {
          "task": "Attente form_post",
          "optional": true,
          "match": "{SUITEURL}test/a/*/callback",
          "commands": [
            [
              "wait",
              "id",
              "submission_complete",
              30
            ]
          ]
        },
        {
          "task": "Attente de l'envoi implicite (query)",
          "optional": true,
          "match": "{SUITEURL}test/a/*/callback?*",
          "commands": [
            [
              "wait",
              "id",
              "submission_complete",
              30
            ]
          ]
        },
        {
          "task": "Attente de l'envoi implicite (fragment)",
          "optional": true,
          "match": "{SUITEURL}test/a/*/callback#*",
          "commands": [
            [
              "wait",
              "id",
              "submission_complete",
              30
            ]
          ]
        }
      ]
    }
  ],
  "vci": {
    "credential_issuer_url": "{OPURL}",
    "credential_configuration_id": "puridentityserver-mso-mdoc",
    "allow_unexpected_credential_issuer_metadata_fields": [
      "mdoc_iaca_certificates"
    ]  },
  "client": {
    "client_id": "puridentityserver-oid4vci-client",
    "scope": "openid openid4vci",
    "jwks": {
      "keys": [
        {
          "kty": "EC",
          "crv": "P-256",
          "x": "odKpJUcrMIJz5oZP9zW2WS5uu6aFTXIvjvA1EJ162n0",
          "y": "kYgAhsqEU1rygzwge47pHWdwrKFuAYl2ApbqTphoZCs",
          "d": "AaBLqunIa-fcy-aQ2hCCiv21okJ6zGUSavs9l8uj6J0",
          "kid": "puridentityserver-oid4vci-client-20261028",
          "alg": "ES256",
          "use": "sig"
        }
      ]
    }
  },
