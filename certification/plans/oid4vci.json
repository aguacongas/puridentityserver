  "browser": [
    {
      "match": "{OPURL}/authorize*",
      "tasks": [
        {
          "task": "Login",
          "optional": true,
          "match": "{OPURL}/login*",
          "commands": [
            [
              "text",
              "name",
              "username",
              "alice@example.com"
            ],
            [
              "text",
              "name",
              "password",
              "password"
            ],
            [
              "click",
              "css",
              "button[type=submit]"
            ]
          ]
        },
        {
          "task": "Consent",
          "optional": true,
          "match": "{OPURL}/consent*",
          "commands": [
            [
              "click",
              "css",
              "button[name=action][value=authorize]"
            ]
          ]
        },
        {
          "task": "Attente form_post",
          "optional": true,
          "match": "{SUITEURL}test/a/*/callback",
          "commands": [
            [
              "wait",
              "id",
              "submission_complete",
              30
            ]
          ]
        },
        {
          "task": "Attente de l'envoi implicite (query)",
          "optional": true,
          "match": "{SUITEURL}test/a/*/callback?*",
          "commands": [
            [
              "wait",
              "id",
              "submission_complete",
              30
            ]
          ]
        },
        {
          "task": "Attente de l'envoi implicite (fragment)",
          "optional": true,
          "match": "{SUITEURL}test/a/*/callback#*",
          "commands": [
            [
              "wait",
              "id",
              "submission_complete",
              30
            ]
          ]
        }
      ]
    }
  ],
  "vci": {
    "credential_issuer_url": "{OPURL}",
    "credential_configuration_id": "puridentityserver-sdjwt-vc",
    "allow_unexpected_credential_issuer_metadata_fields": [
      "mdoc_iaca_certificates"
    ]
  },
