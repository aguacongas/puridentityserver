index c371682..03a8c6c 100644
--- a/scripts/conformance.py
+++ b/scripts/conformance.py
@@ -375,6 +375,55 @@ class Conformance(object):
             filled += 1
         return filled
 
+    async def release_alias(self, alias, timeout=180):
+        # La suite reserve l'alias au moment de la CREATION du test : quand un test
+        # precedent detient encore cet alias et n'est pas a l'etat final, il est arrete
+        # avec « Stopping test due to alias conflict - before this test finished, you
+        # have started another test using the same alias ». Cela arrive des que la
+        # creation du module suivant precede la fin du precedent (module qui depasse
+        # CONFORMANCE_MODULE_TIMEOUT et reste actif, run annule en cours de route...).
+        # On libere donc l'alias nous-memes avant chaque creation : on arrete les tests
+        # non finalises qui le detiennent (DELETE api/runner/{id}) et on attend leur
+        # etat final, pour que la revendication par le nouveau test se fasse sans conflit.
+        if not alias:
+            return
+        running = await self._request(self.httpclient.get, "list_running_tests", 200,
+                                      url='{0}api/runner/running'.format(self.api_url_base))
+        stale = []
+        for module_id in running.json():
+            try:
+                info = await self.get_module_info(module_id)
+            except Exception as e:
+                print("release_alias: info {} unavailable - {}".format(module_id, e))
+                continue
+            config = info.get('config') or {}
+            if info.get('alias') != alias and config.get('alias') != alias:
+                continue
+            if info.get('status') in ('FINISHED', 'INTERRUPTED'):
+                continue
+            stale.append((module_id, info.get('testName') or module_id, info.get('status')))
+        if not stale:
+            return
+        for module_id, test_name, status in stale:
+            print("release_alias: stopping {} ({}) in state {} - alias '{}' still in use".format(
+                test_name, module_id, status, alias))
+            response = await self.httpclient.delete('{0}api/runner/{1}'.format(self.api_url_base, module_id))
+            if response.status_code not in (200, 404):
+                raise Exception("release_alias cancel failed - HTTP {:d} {}".format(response.status_code, response.content))
+        deadline = time.time() + timeout
+        for module_id, test_name, status in stale:
+            while True:
+                if time.time() >= deadline:
+                    print("release_alias: {} is not final after {}s - continuing anyway".format(test_name, timeout))
+                    break
+                try:
+                    info = await self.get_module_info(module_id)
+                except Exception:
+                    break
+                if info.get('status') in ('FINISHED', 'INTERRUPTED'):
+                    break
+                await asyncio.sleep(2)
+
     async def start_test(self, module_id):
         api_url = '{0}api/runner/{1}'.format(self.api_url_base, module_id)
         response = await self._request(self.httpclient.post, "start_test", 200,
