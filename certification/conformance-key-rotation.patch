+async def rotate_op_signing_keys():
+    """Force la rotation des cles de signature de l'OP (avant le demarrage du module).
+
+    Le module ``oidcc-server-rotate-keys`` compare le JWKS avant et apres le
+    demarrage du test : la rotation doit avoir lieu ENTRE les deux releves, ce
+    que seul l'OP peut faire (l'operateur de la certification ne peut pas
+    agir a ce moment-la). L'endpoint d'administration de l'OP est appele si
+    son URL et son jeton sont fournis par l'environnement
+    (``KEY_ROTATION_ENDPOINT`` / ``KEY_ROTATION_TOKEN``) ; sinon la rotation
+    n'est pas declenchee et le module reproduit son ecart attendu.
+    """
+    endpoint = os.getenv('KEY_ROTATION_ENDPOINT')
+    token = os.getenv('KEY_ROTATION_TOKEN')
+    if not endpoint or not token:
+        print('KEY_ROTATION_ENDPOINT/KEY_ROTATION_TOKEN absents : rotation des cles de signature non declenchee')
+        return
+    verify_ssl = 'CONFORMANCE_DEV_MODE' not in os.environ and 'DISABLE_SSL_VERIFY' not in os.environ
+    request = urllib.request.Request(
+        endpoint,
+        data=b'',
+        method='POST',
+        headers={'Authorization': 'Bearer ' + token},
+    )
+    context = None
+    if not verify_ssl:
+        context = ssl.create_default_context()
+        context.check_hostname = False
+        context.verify_mode = ssl.CERT_NONE
+    try:
+        with urllib.request.urlopen(request, timeout=60, context=context) as response:
+            print("Rotation des cles de signature de l'OP : HTTP {}".format(response.status))
+    except Exception as error:
+        print("Rotation des cles de signature de l'OP impossible : {}".format(error))
+
+
